# Generated into out/.htaccess by npm run build. Requires Apache 2.4,
# mod_rewrite, mod_headers and AllowOverride for these directives.
Options -Indexes
ServerSignature Off
ErrorDocument 404 /404.html

RewriteEngine On
RewriteRule (^|/)\.git(?:/|$) - [F,END,NC]
RewriteRule (^|/)\.env(?:\.|$) - [F,END,NC]

# Preserve query parameters while sending previous website URLs to current pages.
RewriteRule ^services/gardening(?:\.html)?/?$ /leistungen/gartenbau/ [R=301,END,NC]
RewriteRule ^services/tief-bau(?:\.html)?/?$ /leistungen/tiefbau/ [R=301,END,NC]
RewriteRule ^services/landscaping(?:\.html)?/?$ /leistungen/landschaftsbau/ [R=301,END,NC]
RewriteRule ^services(?:\.html)?/?$ /leistungen/ [R=301,END,NC]
RewriteRule ^about-us(?:\.html)?/?$ /unternehmen/ [R=301,END,NC]
RewriteRule ^contact-us(?:\.html)?/?$ /kontakt/ [R=301,END,NC]

AddType image/webp .webp
AddType font/ttf .ttf

Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "DENY"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
# Applies to the apex hostname; subdomains are deliberately not included.
Header always set Strict-Transport-Security "max-age=31536000"
# Inline scripts are hashed from this build, rather than allowed indiscriminately.
Header always set Content-Security-Policy "default-src 'self'; script-src 'self' __SCRIPT_HASHES__; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"

<FilesMatch "\.(?:html|txt|xml)$">
  Header set Cache-Control "no-cache"
</FilesMatch>
<FilesMatch "\.(?:js|css)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
